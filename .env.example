# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenRouter key used by Hermes for model inference (free models need no credit).
OPENROUTER_API_KEY=

# API server binding. Keep 127.0.0.1 unless you put the app behind an authenticating proxy.
HOST=127.0.0.1
PORT=3000

# Extra hostnames the API may be reached by (comma-separated), e.g. a tunnel's public name.
# Requests addressed to any other host are rejected to block DNS-rebinding attacks.
ALLOWED_HOSTS=

# pretty | json
LOG_FORMAT=pretty
