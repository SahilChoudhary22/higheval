# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Provider keys. You can also add them in the app under Settings, which overrides these.
# OpenRouter is used by the sample configs and the LLM judge (free models need no credit).
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# NVIDIA_API_KEY=

# API server binding. Keep 127.0.0.1 unless you put the app behind an authenticating proxy.
HOST=127.0.0.1
PORT=3000

# Extra hostnames the API may be reached by (comma-separated), e.g. a tunnel's public name.
# Requests addressed to any other host are rejected to block DNS-rebinding attacks.
ALLOWED_HOSTS=

# pretty | json
LOG_FORMAT=pretty

# Hosted deployments only. Set both to require sign-in for the UI and the API
# (required when HOST is not 127.0.0.1). SESSION_SECRET (32+ characters) keeps
# people signed in across restarts.
# AUTH_USERNAME=
# AUTH_PASSWORD=
# SESSION_SECRET=
# Stop visitors from changing provider keys in Settings.
# PROVIDER_KEYS_READ_ONLY=true
