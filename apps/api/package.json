{
  "name": "@higheval/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API: definitions, experiment orchestration, scoring and comparison.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "oxlint --type-aware --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@higheval/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2004",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
